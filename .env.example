# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
APP_BASE_DOMAIN=payroll.anutech.in

# --- Postgres (used by docker-compose interpolation + backend) ---
POSTGRES_USER=anutech
POSTGRES_PASSWORD=anutech
POSTGRES_DB=anutech_payroll
DATABASE_URL=postgresql+psycopg2://anutech:anutech@localhost:5432/anutech_payroll
MASTER_SCHEMA=public

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
# Verify the latest model id with the lead before coding agents.
ANTHROPIC_MODEL=claude-opus-4-7

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@anutech.in

# --- Zoho Books (see ZOHO_SETUP.md for the one-time OAuth setup) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=        # numeric org id from Zoho Books → Settings → Profile
ZOHO_SALARIES_ACCOUNT_ID=    # account id of the expense account where salaries should land
ZOHO_REGION=in               # in / com / eu / com.au / jp / ca

# --- Payroll constants ---
DEFAULT_PROFESSIONAL_TAX=200
ESI_GROSS_THRESHOLD=21000
